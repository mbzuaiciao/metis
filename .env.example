# demo | meta | anthropic. Explicit live configuration never silently falls back.
METIS_PROVIDER=demo
METIS_MODEL=
# For live Llama: set METIS_PROVIDER=meta and all three METIS_MODEL,
# METIS_META_BASE_URL and METIS_META_API_KEY variables, then restart the backend.
# Base URL including /v1 of your accessible OpenAI-compatible Llama endpoint.
# Do not append /chat/completions or embed credentials in the URL.
METIS_META_BASE_URL=
METIS_META_API_KEY=
ANTHROPIC_API_KEY=
